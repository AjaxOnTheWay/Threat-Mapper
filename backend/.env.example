# --- Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
POSTGRES_DB=threatmapper
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Security ---
# Secret key for JWT Bearer Authentication
JWT_SECRET_KEY=generate_a_random_secure_string_here

# --- External OSINT APIs ---
VIRUSTOTAL_API_KEY=your_vt_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
URLHAUS_API_KEY=your_urlhaus_key_here
MISP_URL=https://your-misp-instance.com
MISP_AUTH_KEY=your_misp_auth_key
HIBP_API_KEY=your_haveibeenpwned_key

# --- SIEM Outbound (Splunk Push Mode) ---
SPLUNK_HEC_URL=https://splunk-heavy-forwarder:8088/services/collector
SPLUNK_HEC_TOKEN=your_splunk_hec_token